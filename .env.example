# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Marketing Services Platform"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: usar localhost. Prod (docker-compose.prod.yml): usar nombre de servicio "postgres"
DATABASE_URL=postgresql+asyncpg://marketing:marketing_password@localhost:5432/marketing_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=local_dev_only_change_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes del frontend autorizados a llamar la API. En prod => dominio real.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://crm.mirkocalzadilla.com,https://mirkocalzadilla.com

# ── WhatsApp / Meta Cloud API ─────────────────────────────────────────────────
# Credenciales reales en PROD (VPS). Vacías en local salvo que pruebes el webhook.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_DEFAULT_AGENT_ID=
WHATSAPP_APP_SECRET=

# ── LLM runtime ───────────────────────────────────────────────────────────────
# Provider: "anthropic" (default) | "openai". Model IDs pineados.
LLM_PROVIDER=openai
LLM_MAX_TOKENS=1024
# Anthropic (default) — console.anthropic.com → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
LLM_MODEL_HAIKU=claude-haiku-4-5-20251001
LLM_MODEL_SONNET=claude-sonnet-4-6
# OpenAI (alterno) — platform.openai.com → API keys (sk-...)
OPENAI_API_KEY=
LLM_OPENAI_MODEL_LOOP=gpt-4o-mini-2024-07-18
LLM_OPENAI_MODEL_SUMMARY=gpt-4o-mini-2024-07-18

# ── Health (#246) ─────────────────────────────────────────────────────────────
# Bearer para ver sha/version en /health/deep. Vacío => solo respuesta sanitizada.
# Prod: generar con `openssl rand -hex 32` y setear en el .env del VPS.
HEALTH_TOKEN=

# ── Opcionales (default en config.py; descomentar si hace falta) ───────────────
# MEDIA_ROOT=uploads
# MEDIA_BASE_URL=http://localhost:8000
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=
